{
	"name": "flarum-lang/greek",
	"description": "Greek Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/greek",
	"license": "MIT",
	"authors": [
		{
			"name": "futuresound",
			"homepage": "https://github.com/futuresound",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/greek/issues",
		"forum": "https://discuss.flarum.org/d/26162",
		"source": "https://github.com/flarum-lang/greek"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Greek",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#ffffff",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "el",
			"title": "Ελληνικά"
		}
	}
}
